# Hohlraum-like grey radiation transport with QDSMC hybrid electrons.

FILE = inputs_base_rz

algo.maxwell_solver = hybrid
warpx.grid_type = collocated

hybrid_pic_model.elec_temp = Te_wall_eV
hybrid_pic_model.n0_ref = n_wall
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.n_floor = n_fill
hybrid_pic_model.substeps = 4
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.solve_electron_energy_equation = 1
hybrid_pic_model.include_joule_heating = 0

particles.species_names = wall_ions photons

wall_ions.species_type = proton
wall_ions.injection_style = NUniformPerCell
wall_ions.num_particles_per_cell_each_dim = 2 1 2
wall_ions.profile = parse_density_function
wall_ions.density_function(x,y,z) = if( \
    (sqrt(x*x+y*y) > r_wall) \
    + ((abs(z) > z_wall)*(sqrt(x*x+y*y) > r_leh)), \
    n_wall, n_fill)
wall_ions.momentum_distribution_type = constant
wall_ions.ux = 0.0
wall_ions.uy = 0.0
wall_ions.uz = 0.0

radiation_transport.material_coupling = hybrid_electrons

diag1.fields_to_plot = rho Te radiation_material_energy radiation_diffusion_energy
