# Sparse, moving, multi-box Cartesian resolved-Qei native fixture. Shared base input.
max_step = 0
amr.n_cell = 8 8
amr.max_level = 0
amr.max_grid_size = 4
amr.blocking_factor = 2
geometry.dims = 2
geometry.prob_lo = 0 0
geometry.prob_hi = 8.e-6 8.e-6
boundary.field_lo = periodic periodic
boundary.field_hi = periodic periodic
boundary.particle_lo = periodic periodic
boundary.particle_hi = periodic periodic
warpx.const_dt = 1.e-11
warpx.verbose = 0
warpx.grid_type = collocated
warpx.use_filter = 0
warpx.random_seed = 42
warpx.serialize_initial_conditions = 1
algo.maxwell_solver = hybrid
algo.particle_shape = 1
algo.current_deposition = direct
hybrid_pic_model.elec_temp = 100
hybrid_pic_model.initial_elec_temp(x,y,z) = 100
hybrid_pic_model.n0_ref = 1.e20
hybrid_pic_model.n_floor = 1.e10
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.substeps = 2
hybrid_pic_model.solve_electron_energy_equation = 1
hybrid_pic_model.electron_thermodynamics = ideal_gas
hybrid_pic_model.electron_energy_transport = finite_volume
hybrid_pic_model.resolved_qei_support = 1
hybrid_pic_model.electron_ion_relaxation_rate(rho,Te,Ti,t) = 1.e10
hybrid_pic_model.electron_ion_relaxation_species = light heavy
hybrid_pic_model.electron_ion_relaxation_rate_light(rho_s,rho,Te,Ti,t) = 1.3e10
hybrid_pic_model.electron_ion_relaxation_rate_heavy(rho_s,rho,Te,Ti,t) = 0.7e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0
particles.species_names = light heavy
light.species_type = proton
light.injection_style = none
light.do_not_gather = 1
heavy.mass = 4*m_p
heavy.charge = 2*q_e
heavy.injection_style = none
heavy.do_not_gather = 1
diagnostics.enable = 0
amrex.abort_on_unused_inputs = 1
