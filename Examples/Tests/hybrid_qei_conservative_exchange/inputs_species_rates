# Dense two-material Qei control; the test supplies explicit rate selections.
my_constants.n0 = 1.e23
max_step = 0
amr.n_cell = 8 16
amr.max_level = 0
amr.max_grid_size = 8
amr.blocking_factor = 4
geometry.dims = RZ
geometry.prob_lo = 0 0
geometry.prob_hi = 1.e-3 1.e-3
boundary.field_lo = none pec
boundary.field_hi = pec pec
boundary.particle_lo = none reflecting
boundary.particle_hi = reflecting reflecting
warpx.n_rz_azimuthal_modes = 1
warpx.const_dt = 2.e-13
warpx.verbose = 0
warpx.grid_type = collocated
warpx.use_filter = 0
warpx.random_seed = 42
warpx.serialize_initial_conditions = 1
algo.maxwell_solver = hybrid
algo.particle_shape = 3
algo.current_deposition = direct
hybrid_pic_model.elec_temp = 100
hybrid_pic_model.initial_elec_temp(x,y,z) = 100
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.n_floor = 1.e10
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.substeps = 2
hybrid_pic_model.solve_electron_energy_equation = 1
hybrid_pic_model.electron_thermodynamics = ideal_gas
hybrid_pic_model.electron_energy_transport = finite_volume
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0
particles.species_names = ions heavy
ions.species_type = proton
ions.injection_style = NUniformPerCell
ions.num_particles_per_cell_each_dim = 4 1 4
ions.radial_numpercell_power = 0
ions.profile = constant
ions.density = n0
ions.momentum_distribution_type = gaussian
ions.ux_th = sqrt(10*q_e/m_p)/clight
ions.uy_th = sqrt(10*q_e/m_p)/clight
ions.uz_th = sqrt(10*q_e/m_p)/clight
ions.do_not_gather = 1
heavy.mass = 4*m_p
heavy.charge = 2*q_e
heavy.injection_style = NUniformPerCell
heavy.num_particles_per_cell_each_dim = 4 1 4
heavy.radial_numpercell_power = 0
heavy.profile = constant
heavy.density = n0/2
heavy.momentum_distribution_type = gaussian
heavy.ux_th = sqrt(10*q_e/(4*m_p))/clight
heavy.uy_th = sqrt(10*q_e/(4*m_p))/clight
heavy.uz_th = sqrt(10*q_e/(4*m_p))/clight
heavy.do_not_gather = 1
diagnostics.enable = 0
amrex.abort_on_unused_inputs = 1
