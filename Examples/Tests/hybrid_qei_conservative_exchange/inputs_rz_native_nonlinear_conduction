# Radial hot-core relaxation with native PIC-deposited density and latent calorics.
my_constants.n0 = 0.5*(2.0/3.0)/kb
my_constants.radius = 1.e-3
max_step = 64
amrex.the_arena_init_size = 0
amr.n_cell = 64 8
amr.max_level = 0
amr.max_grid_size = 16 8
amr.blocking_factor = 4
geometry.dims = RZ
geometry.prob_lo = 0 0
geometry.prob_hi = radius radius
boundary.field_lo = none periodic
boundary.field_hi = pec periodic
boundary.particle_lo = none periodic
boundary.particle_hi = reflecting periodic
warpx.n_rz_azimuthal_modes = 1
warpx.const_dt = 0.03*radius^2/64
warpx.verbose = 0
warpx.grid_type = collocated
warpx.use_filter = 0
warpx.synchronize_velocity_for_diagnostics = 0
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.particle_shape = 1
particles.species_names = ions
ions.mass = m_p
ions.charge = q_e
ions.injection_style = NUniformPerCell
ions.num_particles_per_cell_each_dim = 4 8 2
ions.radial_numpercell_power = 0
ions.profile = constant
ions.density = n0
ions.momentum_distribution_type = constant
ions.ux = 0
ions.uy = 0
ions.uz = 0
ions.do_not_push = 1
ions.do_not_gather = 1
hybrid_pic_model.elec_temp = 10
hybrid_pic_model.initial_elec_temp(x,y,z) = 10*(1+0.5*cos(pi*sqrt(x*x+y*y)/radius))
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.n_floor = 0.001*n0
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.substeps = 2
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0
hybrid_pic_model.solve_electron_energy_equation = 1
hybrid_pic_model.electron_energy_transport = finite_volume
hybrid_pic_model.include_joule_heating = 0
hybrid_pic_model.electron_thermodynamics = fixed_charge_latent_energy
hybrid_pic_model.electron_latent_transition_temperature_eV = 10
hybrid_pic_model.electron_latent_energy_eV = 40
hybrid_pic_model.electron_latent_sharpness = 8
hybrid_pic_model.electron_heat_conduction = 1
hybrid_pic_model.electron_thermal_conductivity(rho,Te) = 0.5
hybrid_pic_model.electron_conduction_flux_limiter = 0
