# Two unequal-mass ion species, a moving cell mean, and an eight-box domain. Shared base input.
my_constants.n0 = 1.e20
max_step = 2
amr.n_cell = 8 8 8
amr.max_level = 0
amr.max_grid_size = 4
amr.blocking_factor = 2
geometry.dims = 3
geometry.prob_lo = 0 0 0
