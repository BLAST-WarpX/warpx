# Moving, nonuniform, fully populated plasma: exercise transport and Qei restart.
my_constants.n0 = 1.e23
my_constants.length = 1.e-3
max_step = 200
amr.n_cell = 8 16
amr.max_level = 0
amr.max_grid_size = 8
amr.blocking_factor = 4
geometry.dims = RZ
geometry.prob_lo = 0 0
geometry.prob_hi = length length
boundary.field_lo = none periodic
boundary.field_hi = pec periodic
boundary.particle_lo = none periodic
boundary.particle_hi = reflecting periodic
warpx.n_rz_azimuthal_modes = 1
warpx.const_dt = 2.e-12
warpx.verbose = 0
warpx.grid_type = collocated
warpx.use_filter = 0
warpx.random_seed = 42
warpx.serialize_initial_conditions = 1
warpx.do_dynamic_scheduling = 0
warpx.sort_intervals = -1
warpx.synchronize_velocity_for_diagnostics = 0
algo.maxwell_solver = hybrid
algo.particle_shape = 3
algo.current_deposition = direct
hybrid_pic_model.elec_temp = 100
hybrid_pic_model.initial_elec_temp(x,y,z) = 100
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.n_floor = 0.01*n0
hybrid_pic_model.substeps = 2
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0
hybrid_pic_model.solve_electron_energy_equation = 1
hybrid_pic_model.include_joule_heating = 0
hybrid_pic_model.electron_thermodynamics = ideal_gas
hybrid_pic_model.electron_energy_transport = finite_volume
hybrid_pic_model.resolved_qei_support = 1
hybrid_pic_model.electron_ion_relaxation_rate(rho,Te,Ti,t) = 1.e10
particles.species_names = ions
ions.species_type = proton
ions.injection_style = NUniformPerCell
ions.num_particles_per_cell_each_dim = 4 1 4
ions.radial_numpercell_power = 0
ions.profile = parse_density_function
ions.density_function(x,y,z) = "n0*(1+0.2*sin(2*pi*z/length))"
ions.momentum_distribution_type = gaussian
ions.ux_th = 1.e-4
ions.uy_th = 1.e-4
ions.uz_th = 1.e-4
ions.uz_m = 1.e-3
ions.do_not_gather = 1
diagnostics.diags_names = diag chk
diag.diag_type = Full
diag.format = plotfile
diag.intervals = 100
diag.file_prefix = diags/plt
diag.fields_to_plot = rho Te hybrid_qei_electron_energy_cumulative_fp
chk.diag_type = Full
chk.format = checkpoint
chk.intervals = 100
chk.file_prefix = diags/chk
amrex.the_arena_init_size = 0
