# Deterministic native two-particle temperature deposition regression.
# Particle momenta stay fixed by disabling the push and gather.
# The exact unbiased two-sample variance is (v1-v2)^2/2 at each grid point
# receiving both particles, regardless of their positive effective weights.
max_step = 2
amr.max_level = 0
amr.max_grid_size = 8
amr.blocking_factor = 8
warpx.verbose = 0
warpx.const_dt = 1.e-15
warpx.use_filter = 0
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.particle_shape = 3
hybrid_pic_model.elec_temp = 0.
hybrid_pic_model.n0_ref = 1.
hybrid_pic_model.gamma = 1.
hybrid_pic_model.n_floor = 1.

particles.species_names = equal macro shape small large axis nearaxis single zero dominant

diagnostics.diags_names = diag1
diag1.intervals = 2
diag1.diag_type = Full

# equal: independently checks this weighting/low-support case.
equal.mass = m_p
equal.charge = q_e
equal.do_not_gather = 1
equal.do_not_push = 1
equal.do_temperature_deposition = 1
equal.injection_style = MultipleParticles
equal.multiple_particles_pos_x = 8.25 8.25
equal.multiple_particles_pos_y = y0 y0
equal.multiple_particles_pos_z = 8.25 8.25
equal.multiple_particles_ux = 1/clight -1/clight
equal.multiple_particles_uy = 2/clight -2/clight
equal.multiple_particles_uz = 3/clight -3/clight
equal.multiple_particles_weight = 1.0 1.0

