# 0-D DSMC rovibrational-relaxation test (Borgnakke-Larsen: classical rotation + quantum vibration).
#
# Homogeneous, field-free box of neutral D2 with D2-D2 elastic hard-sphere collisions. The gas
# starts translationally hot (T_trans = 6000 K) with rotation and vibration cold. The
# Borgnakke-Larsen model relaxes:
#   - rotation (classical, zeta_rot = 2)          -> equipartitions with translation at T_eq,
#   - vibration (quantum harmonic, theta_vib)     -> ACTIVATES but stays SUB-equipartition
#                                                    (<E_vib> < kB T_eq; a classical mode would not).
# Energy conservation: (3/2) T_trans + T_rot + <E_vib>/kB = const, giving T_eq ~ 3050 K.
#
# This is the slow (quantitative) variant: it runs to near-equilibrium so the analysis can check
# translation/rotation equipartition and the quantum suppression of the vibrational energy.
# NOTE: Z_vib = 5 is an artificially small relaxation number so the vibrational exchange is visible
# in a short run; it sets only the RATE, not the equilibrium population.

my_constants.mD2  = 6.689e-27
my_constants.kB   = 1.380649e-23
my_constants.Ttr0 = 6000.0
my_constants.n0   = 1.0e22
my_constants.uth_c = sqrt(kB*Ttr0/mD2)/clight

geometry.dims       = 3
geometry.prob_lo    = 0.0 0.0 0.0
geometry.prob_hi    = 1.0e-3 1.0e-3 1.0e-3
amr.n_cell          = 4 4 4
amr.max_level       = 0
amr.blocking_factor = 4
amr.max_grid_size   = 4

algo.maxwell_solver = none
algo.particle_shape = 1
warpx.const_dt      = 5.0e-9
max_step            = 1000
warpx.verbose       = 1

boundary.field_lo    = periodic periodic periodic
boundary.field_hi    = periodic periodic periodic
boundary.particle_lo = periodic periodic periodic
boundary.particle_hi = periodic periodic periodic

particles.species_names = D2
D2.charge = 0.0
D2.mass   = mD2
D2.injection_style = NUniformPerCell
D2.num_particles_per_cell_each_dim = 6 6 6
D2.profile = constant
D2.density = n0
D2.momentum_distribution_type = gaussian
D2.ux_th = uth_c
D2.uy_th = uth_c
D2.uz_th = uth_c

D2.internal_dof         = rovibrational
D2.theta_rot            = 43.0     # D2 rotational characteristic temperature [K]
D2.Z_rot                = 5.0
D2.rotational_dof       = 2
D2.rot_init_temperature = 0.0
D2.theta_vib            = 4400.0   # D2 vibrational characteristic temperature [K]
D2.Z_vib                = 5.0      # artificially fast (test only)
D2.vib_init_temperature = 0.0

collisions.collision_names = d2el
d2el.type                  = dsmc
d2el.scattering_processes  = elastic
d2el.species               = D2 D2
d2el.elastic_cross_section = ../../../Examples/Tests/collision/D2_hard_sphere_elastic.dat

diagnostics.diags_names = diag1
diag1.diag_type     = Full
diag1.format        = openpmd
diag1.intervals     = 1000
diag1.fields_to_plot = none
diag1.write_species = 1
diag1.species       = D2
diag1.D2.variables  = w ux uy uz E_rot E_vib
