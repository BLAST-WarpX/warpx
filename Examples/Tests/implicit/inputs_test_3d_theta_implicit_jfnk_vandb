# base input parameters
FILE = inputs_base_vandb

# test input parameters
my_constants.nppcz = 2           # number of particles/cell in each dim

max_step = 10
amr.n_cell = 16 16 16
geometry.dims = 3
geometry.prob_lo = 0.0  0.0  0.0  # physical domain
geometry.prob_hi = 4.0*de0  4.0*de0  4.0*de0

boundary.field_lo = periodic periodic periodic
boundary.field_hi = periodic periodic periodic

newton.diagnostic_interval = 10

gmres.relative_tolerance = 1.0e-6

implicit_evolve.use_mass_matrices_jacobian = true
implicit_evolve.use_mass_matrices_pc = true
jacobian.pc_type = "pc_curl_curl_mlmg"
pc_curl_curl_mlmg.verbose = true
pc_curl_curl_mlmg.max_iter = 1
pc_curl_curl_mlmg.relative_tolerance = 1e-4

algo.current_deposition = "direct"

electrons.num_particles_per_cell_each_dim = nppcz nppcz nppcz
protons.num_particles_per_cell_each_dim = nppcz nppcz nppcz

diag1.intervals = 10
diag1.electrons.variables = x y z w ux uy uz
diag1.protons.variables = x y z w ux uy uz
