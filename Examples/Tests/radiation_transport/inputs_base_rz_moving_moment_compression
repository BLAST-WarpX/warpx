# Bounded radial compression/LTE integration; see radiation_rz_moving_runtime.md.
my_constants.n0 = 1000/m_p
my_constants.radius = 1.e-3
my_constants.inward_speed = 2.e4
max_step = 256
amr.n_cell = 32 8
amr.max_level = 0
amr.max_grid_size = 16 8
amr.blocking_factor = 4
geometry.dims = RZ
geometry.prob_lo = 0 0
geometry.prob_hi = radius 0.001
boundary.field_lo = none periodic
boundary.field_hi = pec periodic
boundary.particle_lo = none periodic
boundary.particle_hi = reflecting periodic
warpx.n_rz_azimuthal_modes = 1
warpx.const_dt = 1.e-11
warpx.verbose = 0
warpx.grid_type = collocated
warpx.use_filter = 0
warpx.synchronize_velocity_for_diagnostics = 0
algo.maxwell_solver = hybrid
algo.particle_shape = 1
algo.current_deposition = direct
hybrid_pic_model.elec_temp = 1
hybrid_pic_model.initial_elec_temp(x,y,z) = 1
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.n_floor = 0.01*n0
hybrid_pic_model.substeps = 2
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0
hybrid_pic_model.solve_electron_energy_equation = 1
hybrid_pic_model.include_joule_heating = 0
hybrid_pic_model.electron_thermodynamics = ideal_gas
hybrid_pic_model.electron_energy_transport = finite_volume_implicit
hybrid_pic_model.conservative_pressure_work = 1
hybrid_pic_model.conservative_pressure_work_pec = 1
particles.species_names = ions photons
ions.species_type = proton
ions.injection_style = NUniformPerCell
ions.num_particles_per_cell_each_dim = 2 8 2
ions.radial_numpercell_power = 0
ions.profile = constant
ions.density = n0
ions.momentum_distribution_type = parse_momentum_function
ions.momentum_function_ux(x,y,z) = "-inward_speed*x/max(sqrt(x*x+y*y),1.e-30)*sin(pi*sqrt(x*x+y*y)/radius)/clight"
ions.momentum_function_uy(x,y,z) = "-inward_speed*y/max(sqrt(x*x+y*y),1.e-30)*sin(pi*sqrt(x*x+y*y)/radius)/clight"
ions.momentum_function_uz(x,y,z) = 0
ions.do_not_push = 0
ions.do_not_gather = 0
photons.species_type = photon
photons.injection_style = none
photons.do_not_deposit = 1
photons.do_not_gather = 1
photons.do_not_push = 1
radiation_transport.enabled = 1
radiation_transport.photon_species = photons
radiation_transport.absorption_coefficient = 0
radiation_transport.material_coupling = hybrid_electrons
radiation_transport.enable_lte_exchange = 1
radiation_transport.enable_diffusion = 1
radiation_transport.diffusion_solver = coupled_moment
radiation_transport.lte_exchange_tolerance = 1.e-11
radiation_transport.lte_exchange_max_iterations = 150
radiation_transport.enable_particle_conversion = 0
radiation_transport.initial_diffusion_energy_density(x,y,z) = 1.e11
radiation_transport.rosseland_transport_coefficient(x,y,z,t,ne,Te) = 1.e7
radiation_transport.planck_absorption_coefficient = 1
radiation_transport.enable_momentum_coupling = 1
radiation_transport.momentum_carry = particle
radiation_transport.momentum_species = ions
radiation_transport.coupled_max_subdivisions = 6
radiation_transport.initial_moment_flux_ratio = 0 0 0
radiation_transport.moment_relaxation = 1
radiation_transport.diffusion_solver_verbosity = 1
diagnostics.diags_names = diag1 chk
diag1.diag_type = Full
diag1.format = plotfile
diag1.intervals = 128
diag1.file_prefix = diags/diag1
diag1.fields_to_plot = rho Te Pe radiation_diffusion_energy radiation_material_energy radiation_material_kinetic_energy radiation_moment_qx radiation_moment_qy radiation_moment_qz
chk.diag_type = Full
chk.format = checkpoint
chk.intervals = 128
chk.file_prefix = diags/chk
warpx.reduced_diags_names = radiation_energy radiation_momentum
radiation_energy.type = RadiationEnergy
radiation_energy.intervals = 1
radiation_energy.path = diags/
radiation_momentum.type = RadiationMomentum
radiation_momentum.intervals = 1
radiation_momentum.path = diags/
radiation_momentum.include_moment_inventory = 1
radiation_momentum.include_moment_transport = 1
