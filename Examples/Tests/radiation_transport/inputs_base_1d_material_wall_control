# Native material-only prerequisite for radiation carry at a fixed wall.
# This does not enable radiation transport or remove its periodic guards.
my_constants.n0 = 100/m_p
my_constants.beta0 = 9.e4/clight
max_step = 3200
amr.n_cell = 128
amr.max_level = 0
amr.max_grid_size = 64
amr.blocking_factor = 8
geometry.dims = 1
geometry.prob_lo = 0
geometry.prob_hi = 0.001
boundary.field_lo = pec
boundary.field_hi = pec
boundary.particle_lo = reflecting
boundary.particle_hi = reflecting
warpx.const_dt = 1.e-12
warpx.verbose = 0
warpx.grid_type = collocated
warpx.use_filter = 0
warpx.synchronize_velocity_for_diagnostics = 0
interpolation.galerkin_scheme = 0
algo.maxwell_solver = hybrid
algo.particle_shape = 4
algo.current_deposition = direct
hybrid_pic_model.elec_temp = 1
hybrid_pic_model.initial_elec_temp(x,y,z) = 100
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.n_floor = 0.01*n0
hybrid_pic_model.substeps = 2
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0
hybrid_pic_model.solve_electron_energy_equation = 1
hybrid_pic_model.include_joule_heating = 0
hybrid_pic_model.electron_thermodynamics = fixed_charge_latent_energy
hybrid_pic_model.electron_latent_transition_temperature_eV = 1
hybrid_pic_model.electron_latent_energy_eV = 2
hybrid_pic_model.electron_latent_sharpness = 4
hybrid_pic_model.conservative_pressure_work = 1
particles.species_names = ions
ions.species_type = proton
ions.injection_style = NUniformPerCell
ions.num_particles_per_cell_each_dim = 4
ions.profile = parse_density_function
ions.density_function(x,y,z) = n0
ions.momentum_distribution_type = constant
ions.ux = 0
ions.uy = 0
ions.uz = beta0/sqrt(1-beta0^2)
diagnostics.diags_names = diag1 chk
diag1.diag_type = Full
diag1.format = plotfile
diag1.intervals = 400
diag1.file_prefix = diags/diag1
diag1.fields_to_plot = rho Te Pe Ez
diag1.plot_raw_fields = 1
chk.diag_type = Full
chk.format = checkpoint
chk.intervals = 400
chk.file_prefix = diags/chk
