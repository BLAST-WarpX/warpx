# Chronological physical packets in a stationary heterogeneous scattering slab.
# No scalar/vector conversion or accelerated diffusion is selected.
my_constants.n0 = 1.e20
my_constants.E0 = 1.e4
my_constants.dt0 = 1.e-11
my_constants.chi = 200
max_step = 80
amrex.the_arena_init_size = 0
amr.n_cell = 8 8 8
amr.max_level = 0
amr.max_grid_size = 4
amr.blocking_factor = 4
geometry.dims = 3
geometry.prob_lo = 0 0 0
geometry.prob_hi = 1 1 1
boundary.field_lo = periodic periodic periodic
boundary.field_hi = periodic periodic periodic
boundary.particle_lo = periodic periodic periodic
boundary.particle_hi = periodic periodic periodic
warpx.const_dt = dt0
warpx.verbose = 0
warpx.grid_type = collocated
warpx.use_filter = 0
warpx.serialize_initial_conditions = 1
warpx.random_seed = 42
warpx.synchronize_velocity_for_diagnostics = 0
algo.maxwell_solver = hybrid
algo.particle_shape = 1
algo.current_deposition = direct
interpolation.galerkin_scheme = 0
hybrid_pic_model.elec_temp = 1
hybrid_pic_model.initial_elec_temp(x,y,z) = 1
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.n_floor = 0.01*n0
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.substeps = 2
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0
hybrid_pic_model.solve_electron_energy_equation = 1
hybrid_pic_model.include_joule_heating = 0
hybrid_pic_model.electron_thermodynamics = ideal_gas
hybrid_pic_model.electron_energy_transport = finite_volume
hybrid_pic_model.conservative_pressure_work = 1
particles.species_names = ions photons
ions.species_type = proton
ions.injection_style = NUniformPerCell
ions.num_particles_per_cell_each_dim = 2 2 2
ions.profile = constant
ions.density = n0
ions.momentum_distribution_type = constant
ions.ux = 0
ions.uy = 0
ions.uz = 0
ions.do_not_push = 0
ions.do_not_gather = 0
photons.species_type = photon
photons.injection_style = NUniformPerCell
photons.num_particles_per_cell_each_dim = 2 2 2
photons.profile = parse_density_function
photons.density_function(x,y,z) = \
    "E0/(m_e*clight^2)*if(z >= 0.375 and z < 0.5, 1, 0)"
photons.xmin = 0
photons.xmax = 1
photons.ymin = 0
photons.ymax = 1
photons.zmin = 0.375
photons.zmax = 0.5
photons.momentum_distribution_type = constant
photons.ux = 0.3
photons.uy = 0.4
photons.uz = sqrt(0.75)
photons.do_not_deposit = 1
photons.do_not_gather = 1
photons.do_not_push = 1
radiation_transport.enabled = 1
radiation_transport.photon_species = photons
radiation_transport.material_coupling = hybrid_electrons
radiation_transport.absorption_coefficient = 0
radiation_transport.planck_absorption_coefficient = 0
radiation_transport.rosseland_transport_coefficient(x,y,z,t,ne,Te) = \
    "if(z >= 0.5 and z < 0.75, chi, 0)"
radiation_transport.coherent_packet_transport = 1
radiation_transport.enable_lte_exchange = 0
radiation_transport.enable_diffusion = 0
radiation_transport.diffusion_solver = explicit
radiation_transport.enable_particle_conversion = 0
radiation_transport.enable_momentum_coupling = 1
radiation_transport.momentum_carry = particle
radiation_transport.momentum_species = ions
radiation_transport.coherent_max_subdivisions = 0
radiation_transport.coherent_verbosity = 1
diagnostics.diags_names = diag1 chk
diag1.diag_type = Full
diag1.format = plotfile
diag1.intervals = 10
diag1.file_prefix = diags/diag1
diag1.fields_to_plot = rho Te Pe Ex Ey Ez Bx By Bz radiation_material_energy radiation_material_kinetic_energy
diag1.plot_raw_fields = 1
diag1.write_species = 1
diag1.species = ions photons
chk.diag_type = Full
chk.format = checkpoint
chk.intervals = 40
chk.file_prefix = diags/chk
warpx.reduced_diags_names = radiation_energy radiation_momentum
radiation_energy.type = RadiationEnergy
radiation_energy.intervals = 1
radiation_energy.path = diags/
radiation_energy.precision = 17
radiation_momentum.type = RadiationMomentum
radiation_momentum.intervals = 1
radiation_momentum.path = diags/
radiation_momentum.precision = 17
radiation_momentum.include_moment_inventory = 0
