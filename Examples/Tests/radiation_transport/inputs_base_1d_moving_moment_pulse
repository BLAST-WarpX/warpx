# Production-shaped gray trapped-pulse qualification. FLASH reference first:
# practical_campaign/moving_references_20260909/FLASH_MOVING_PULSE_RESULTS.md
# Uses the actual native PIC evolution loop, not a prescribed-velocity solver.
my_constants.n0 = 1000/m_p
max_step = 800
amr.n_cell = 256
amr.max_level = 0
amr.max_grid_size = 128
geometry.dims = 1
geometry.prob_lo = 0
geometry.prob_hi = 0.001
boundary.field_lo = periodic
boundary.field_hi = periodic
boundary.particle_lo = periodic
boundary.particle_hi = periodic
warpx.const_dt = 4.166666666666666e-12
warpx.verbose = 0
warpx.grid_type = collocated
warpx.use_filter = 0
algo.maxwell_solver = hybrid
algo.particle_shape = 1
algo.current_deposition = direct
hybrid_pic_model.elec_temp = 1
hybrid_pic_model.initial_elec_temp(x,y,z) = 1
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.n_floor = 0.01*n0
hybrid_pic_model.substeps = 2
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0
hybrid_pic_model.solve_electron_energy_equation = 1
hybrid_pic_model.include_joule_heating = 0
particles.species_names = ions photons
ions.species_type = proton
ions.injection_style = NUniformPerCell
ions.num_particles_per_cell_each_dim = 4
ions.profile = constant
ions.density = n0
ions.momentum_distribution_type = constant
ions.ux = 0
ions.uy = 0
ions.uz = beta0/sqrt(1-beta0^2)
ions.do_not_push = 0
ions.do_not_gather = 0
photons.species_type = photon
photons.injection_style = none
photons.do_not_deposit = 1
photons.do_not_gather = 1
photons.do_not_push = 1
radiation_transport.enabled = 1
radiation_transport.photon_species = photons
radiation_transport.absorption_coefficient = 0
radiation_transport.material_coupling = hybrid_electrons
radiation_transport.enable_lte_exchange = 1
radiation_transport.enable_diffusion = 1
radiation_transport.diffusion_solver = coupled_moment
radiation_transport.lte_exchange_tolerance = 1.e-11
radiation_transport.lte_exchange_max_iterations = 150
radiation_transport.enable_particle_conversion = 0
radiation_transport.initial_diffusion_energy_density(x,y,z) = "7.565733250280007e-16*11604.5221^4*(1+(20^4-1)*(exp(-0.5*((z-0.00025)/0.0001)^2)+exp(-0.5*((z-0.00025+0.001)/0.0001)^2)+exp(-0.5*((z-0.00025-0.001)/0.0001)^2)))*(1+beta0^2/3)/(1-beta0^2)"
radiation_transport.rosseland_transport_coefficient(x,y,z,t,ne,Te) = 1.e7
radiation_transport.planck_absorption_coefficient = 0
diagnostics.diags_names = diag1 chk
diag1.diag_type = Full
diag1.format = plotfile
diag1.intervals = 100
diag1.file_prefix = diags/diag1
diag1.fields_to_plot = rho Te Pe radiation_diffusion_energy radiation_material_energy radiation_material_kinetic_energy radiation_moment_qx radiation_moment_qy radiation_moment_qz
chk.diag_type = Full
chk.format = checkpoint
chk.intervals = 400
chk.file_prefix = diags/chk
warpx.reduced_diags_names = radiation_energy
radiation_energy.type = RadiationEnergy
radiation_energy.intervals = 1
radiation_energy.path = diags/
radiation_energy.precision = 17
my_constants.beta0 = 9.e4/clight
amr.blocking_factor = 8
radiation_transport.enable_momentum_coupling = 1
radiation_transport.momentum_carry = particle
radiation_transport.momentum_species = ions
radiation_transport.coupled_max_subdivisions = 6
radiation_transport.initial_moment_flux_ratio = 0 0 "4*beta0/(3+beta0^2)"
