# RZ conservation test for kinetic LTE exchange, diffusion and photon conversion.

my_constants.n0 = 1.0e20
my_constants.Te0 = 1.0e4
my_constants.alpha_planck = 20.0
my_constants.alpha_rosseland = 32.0

max_step = 1
amr.n_cell = 8 16
amr.max_level = 0
amr.max_grid_size = 8
geometry.dims = RZ
geometry.prob_lo = 0.0 0.0
geometry.prob_hi = 0.5 1.0
warpx.n_rz_azimuthal_modes = 1

boundary.field_lo = none periodic
boundary.field_hi = pec periodic
boundary.particle_lo = none periodic
boundary.particle_hi = absorbing periodic

warpx.const_dt = 1.0e-10
warpx.verbose = 0
warpx.use_filter = 0
warpx.random_seed = 42

algo.maxwell_solver = yee
algo.particle_shape = 1
algo.current_deposition = direct

particles.species_names = electrons photons

electrons.species_type = electron
electrons.injection_style = NUniformPerCell
electrons.num_particles_per_cell_each_dim = 4 1 4
electrons.profile = constant
electrons.density = n0
electrons.momentum_distribution_type = gaussian
electrons.ux_th = sqrt(kb*Te0/m_e)/clight
electrons.uy_th = sqrt(kb*Te0/m_e)/clight
electrons.uz_th = sqrt(kb*Te0/m_e)/clight
electrons.do_not_deposit = 1
electrons.do_not_gather = 1
electrons.do_not_push = 1

photons.species_type = photon
photons.injection_style = SingleParticle
photons.single_particle_pos = 0.2 0.0 0.25
photons.single_particle_u = 1.0 0.0 0.0
photons.single_particle_weight = 1.0
photons.do_not_deposit = 1
photons.do_not_gather = 1
photons.do_not_push = 1

radiation_transport.enabled = 1
radiation_transport.photon_species = photons
radiation_transport.absorption_coefficient = 0.0
radiation_transport.material_coupling = kinetic_electrons
radiation_transport.electron_species = electrons
radiation_transport.enable_lte_exchange = 1
radiation_transport.planck_absorption_coefficient(x,y,z,t,ne,Te) = \
    if(z > 0.499, if(z < 0.5625, alpha_planck, 0.0), 0.0)
radiation_transport.enable_diffusion = 1
radiation_transport.rosseland_transport_coefficient(x,y,z,t,ne,Te) = \
    if(z < 0.5625, alpha_rosseland, 0.0)
radiation_transport.minimum_diffusion_optical_depth = 1.0
radiation_transport.diffusion_cfl = 0.1
radiation_transport.enable_particle_conversion = 1
radiation_transport.emission_photon_energy = 1.0e-13

diagnostics.diags_names = diag1
diag1.diag_type = Full
diag1.format = plotfile
diag1.intervals = 1
diag1.file_prefix = diags/diag1
diag1.fields_to_plot = radiation_material_energy radiation_diffusion_energy

warpx.reduced_diags_names = particle_energy radiation_energy
particle_energy.type = ParticleEnergy
particle_energy.intervals = 1
particle_energy.path = diags/
particle_energy.precision = 17
radiation_energy.type = RadiationEnergy
radiation_energy.intervals = 1
radiation_energy.path = diags/
radiation_energy.precision = 17
