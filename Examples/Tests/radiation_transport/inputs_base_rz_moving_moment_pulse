# Bounded meridional runtime: actual PIC drift, not a frozen source.
# See radiation_rz_moving_runtime.md for the supported contract and evidence.
FILE = inputs_base_1d_moving_moment_pulse
geometry.dims = RZ
geometry.prob_lo = 0 0
geometry.prob_hi = 0.001 0.001
amr.n_cell = 8 64
amr.max_grid_size = 8 32
amr.blocking_factor = 4
boundary.field_lo = none periodic
boundary.field_hi = pec periodic
boundary.particle_lo = none periodic
boundary.particle_hi = reflecting periodic
warpx.n_rz_azimuthal_modes = 1
warpx.const_dt = 1.e-11
max_step = 256
ions.num_particles_per_cell_each_dim = 2 8 2
ions.radial_numpercell_power = 0
my_constants.beta0 = 1.e5/clight
hybrid_pic_model.electron_energy_transport = finite_volume_implicit
hybrid_pic_model.electron_thermodynamics = ideal_gas
hybrid_pic_model.conservative_pressure_work = 1
hybrid_pic_model.conservative_pressure_work_pec = 1
warpx.synchronize_velocity_for_diagnostics = 0
radiation_transport.moment_relaxation = 1
radiation_transport.initial_diffusion_energy_density(x,y,z) = "1.e11*(1+0.5*cos(2*pi*z/0.001))*(1+beta0^2/3)/(1-beta0^2)"
radiation_transport.diffusion_solver_verbosity = 1
diag1.intervals = 128
chk.intervals = 128
warpx.reduced_diags_names = radiation_energy radiation_momentum
radiation_momentum.type = RadiationMomentum
radiation_momentum.intervals = 1
radiation_momentum.path = diags/
radiation_momentum.include_moment_inventory = 1
radiation_momentum.include_moment_transport = 1
