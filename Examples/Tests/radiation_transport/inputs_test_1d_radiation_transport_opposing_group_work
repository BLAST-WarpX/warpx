# Counter-gradient groups act on the same moving material.
# This isolates group-resolved work: near-cancelling total force must not erase
# the separate, opposite Doppler work contributions.
my_constants.n0 = 1.0e20
my_constants.c = 299792458.0
my_constants.q_e = 1.602176634e-19
max_step = 2
amr.n_cell = 16
amr.max_level = 0
amr.max_grid_size = 16
geometry.dims = 1
geometry.prob_lo = 0.0
geometry.prob_hi = 1.0
boundary.field_lo = pec
boundary.field_hi = pec
boundary.particle_lo = reflecting
boundary.particle_hi = reflecting
warpx.const_dt = 1.0e-8
warpx.verbose = 0
warpx.grid_type = collocated
warpx.use_filter = 0
algo.maxwell_solver = hybrid
algo.particle_shape = 1
algo.current_deposition = direct
hybrid_pic_model.elec_temp = 1.0
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.n_floor = 0.01*n0
hybrid_pic_model.substeps = 2
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.solve_electron_energy_equation = 1
hybrid_pic_model.include_joule_heating = 0
particles.species_names = ions photons
ions.mass = 1.0e-27
ions.charge = q_e
ions.injection_style = NUniformPerCell
ions.num_particles_per_cell_each_dim = 4
ions.profile = constant
ions.density = n0
ions.momentum_distribution_type = constant
ions.ux = 0.0
ions.uy = 0.0
ions.uz = 1.0e6/c
ions.do_not_gather = 1
ions.do_not_push = 1
photons.species_type = photon
photons.injection_style = SingleParticle
photons.single_particle_pos = 0.0 0.0 0.5
photons.single_particle_u = 0.0 0.0 1.0
photons.single_particle_weight = 0.0
photons.do_not_deposit = 1
photons.do_not_gather = 1
photons.do_not_push = 1
radiation_transport.enabled = 1
radiation_transport.photon_species = photons
radiation_transport.material_coupling = hybrid_electrons
radiation_transport.absorption_coefficient = 0.0
radiation_transport.enable_lte_exchange = 0
radiation_transport.enable_diffusion = 1
radiation_transport.rosseland_transport_coefficient = 4.0e6
radiation_transport.minimum_diffusion_optical_depth = 1.0e5
radiation_transport.diffusion_cfl = 0.1
radiation_transport.enable_particle_conversion = 0
radiation_transport.enable_momentum_coupling = 1
radiation_transport.momentum_species = ions
radiation_transport.diffusion_boundary_lo = reflecting
radiation_transport.diffusion_boundary_hi = reflecting
radiation_transport.energy_group_boundaries = 100.0*q_e
radiation_transport.group_photon_energies = 50.0*q_e 200.0*q_e
radiation_transport.initial_diffusion_energy_density_g0(x,y,z) = 1.0e6+1.0e5*z
radiation_transport.initial_diffusion_energy_density_g1(x,y,z) = 1.0e6-1.0e5*z
diagnostics.diags_names = diag chk
diag.diag_type = Full
diag.format = plotfile
diag.intervals = 1
diag.file_prefix = diags/diag
diag.fields_to_plot = radiation_diffusion_energy_g0 radiation_diffusion_energy_g1 radiation_material_kinetic_energy
warpx.reduced_diags_names = radiation_energy radiation_momentum particle_energy
radiation_energy.type = RadiationEnergy
radiation_energy.intervals = 1
radiation_energy.path = diags/
radiation_energy.precision = 17
radiation_momentum.type = RadiationMomentum
radiation_momentum.intervals = 1
radiation_momentum.path = diags/
radiation_momentum.precision = 17
particle_energy.type = ParticleEnergy
particle_energy.intervals = 1
particle_energy.path = diags/
particle_energy.precision = 17

chk.diag_type = Full
chk.format = checkpoint
chk.intervals = 1
chk.file_prefix = diags/chk
