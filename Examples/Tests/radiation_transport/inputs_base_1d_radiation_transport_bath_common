radiation_transport.minimum_diffusion_optical_depth = 1.0
radiation_transport.diffusion_cfl = 0.5
radiation_transport.enable_particle_conversion = 0
radiation_transport.energy_group_boundaries = 1.0e-19
radiation_transport.group_photon_energies = 0.5e-19 2.0e-19
radiation_transport.initial_diffusion_energy_density_g0(x,y,z) = 0.0
radiation_transport.initial_diffusion_energy_density_g1(x,y,z) = 0.0
radiation_transport.diffusion_boundary_lo = marshak_bath
radiation_transport.diffusion_boundary_hi = marshak_bath
diagnostics.diags_names = diag1 chk
diag1.diag_type = Full
diag1.format = plotfile
diag1.intervals = 100
diag1.file_prefix = diags/diag1
diag1.write_species = 0
diag1.fields_to_plot = radiation_material_energy radiation_diffusion_energy_g0 radiation_diffusion_energy_g1
chk.diag_type = Full
chk.format = checkpoint
chk.intervals = 50
chk.file_prefix = diags/chk
warpx.reduced_diags_names = radiation_energy
radiation_energy.type = RadiationEnergy
radiation_energy.intervals = 1
radiation_energy.path = diags/
