# Species-aware analytic opacity in RCYLINDER.
#
# A deposited background species holds the hybrid-electron state uniform. Two
# non-depositing, stationary ion tracers occupy whole-cell annuli and provide
# the species number densities consumed by the radiation-opacity interface.
# Thus background-only cells are a non-vacuum control: their LTE emission must
# remain exactly zero because neither listed opacity species is present.

my_constants.n0 = 1.0e20
my_constants.Te0_eV = 1.0
my_constants.alpha_foam = 10.0
my_constants.alpha_tungsten = 4.0*alpha_foam
my_constants.group_photon_energy = 100.0*q_e
my_constants.dr = 1.0e-3

max_step = 1
amr.n_cell = 12
amr.max_level = 0
amr.blocking_factor = 4
amr.max_grid_size = 12

geometry.dims = RCYLINDER
geometry.prob_lo = 0.0
geometry.prob_hi = 12.0*dr

boundary.field_lo = none
boundary.field_hi = none
boundary.particle_lo = none
boundary.particle_hi = absorbing

warpx.const_dt = 1.0e-10
warpx.verbose = 0
warpx.grid_type = collocated
warpx.use_filter = 0
warpx.serialize_initial_conditions = 1

algo.maxwell_solver = hybrid
algo.particle_shape = 1
algo.current_deposition = direct

hybrid_pic_model.elec_temp = Te0_eV
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.n_floor = 0.01*n0
hybrid_pic_model.substeps = 2
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.solve_electron_energy_equation = 1
hybrid_pic_model.include_joule_heating = 0

particles.species_names = background foam tungsten photons

# The background alone owns the hybrid electron density and makes ne and Te
# identical in the two tracer annuli and in the control cells.
background.species_type = proton
background.injection_style = NUniformPerCell
background.num_particles_per_cell_each_dim = 8 1
background.radial_numpercell_power = 1.0
background.profile = constant
background.density = n0
background.momentum_distribution_type = constant
background.ux = 0.0
background.uy = 0.0
background.uz = 0.0
background.do_not_push = 1

foam.species_type = proton
foam.injection_style = MultipleParticles
foam.multiple_particles_pos_x = 2.5*dr 3.5*dr
foam.multiple_particles_pos_y = 0.0 0.0
foam.multiple_particles_pos_z = 0.0 0.0
foam.multiple_particles_ux = 0.0 0.0
foam.multiple_particles_uy = 0.0 0.0
foam.multiple_particles_uz = 0.0 0.0
foam.multiple_particles_weight = 5.0*n0*pi*dr^2 7.0*n0*pi*dr^2
# Keep this manufactured opacity tracer out of the hybrid charge/current
# moments. GetNumberDensity() still supplies its cell-centered NGP density to
# the species-aware radiation backend.
foam.do_not_deposit = 1
foam.do_not_push = 1

tungsten.species_type = proton
tungsten.injection_style = MultipleParticles
tungsten.multiple_particles_pos_x = 6.5*dr 7.5*dr
tungsten.multiple_particles_pos_y = 0.0 0.0
tungsten.multiple_particles_pos_z = 0.0 0.0
tungsten.multiple_particles_ux = 0.0 0.0
tungsten.multiple_particles_uy = 0.0 0.0
tungsten.multiple_particles_uz = 0.0 0.0
tungsten.multiple_particles_weight = 13.0*n0*pi*dr^2 15.0*n0*pi*dr^2
tungsten.do_not_deposit = 1
tungsten.do_not_push = 1

photons.species_type = photon
photons.injection_style = SingleParticle
photons.single_particle_pos = 1.0e-4 0.0 0.0
photons.single_particle_u = 0.0 0.0 1.0
photons.single_particle_weight = 1.0
photons.do_not_deposit = 1
photons.do_not_gather = 1
photons.do_not_push = 1

radiation_transport.enabled = 1
radiation_transport.photon_species = photons
radiation_transport.material_coupling = hybrid_electrons
radiation_transport.minimum_electron_density = 0.5*n0
radiation_transport.opacity_species = foam tungsten
radiation_transport.group_photon_energies = group_photon_energy
# Packet absorption is deliberately disabled while exercising the required
# per-species analytic backend.
radiation_transport.absorption_coefficient_foam(x,y,z,t,photon_energy,ni,ne,Te) = 0.0
radiation_transport.absorption_coefficient_tungsten(x,y,z,t,photon_energy,ni,ne,Te) = 0.0
radiation_transport.enable_lte_exchange = 1
radiation_transport.lte_exchange_solver = frozen_temperature
radiation_transport.planck_absorption_coefficient_foam(x,y,z,t,photon_energy,ni,ne,Te) = \
    alpha_foam*ni/n0*photon_energy/group_photon_energy
radiation_transport.planck_absorption_coefficient_tungsten(x,y,z,t,photon_energy,ni,ne,Te) = \
    alpha_tungsten*ni/n0*photon_energy/group_photon_energy
radiation_transport.enable_diffusion = 0
radiation_transport.enable_particle_conversion = 0

diagnostics.diags_names = diag1
diag1.diag_type = Full
diag1.format = plotfile
diag1.intervals = 1
diag1.file_prefix = diags/diag1
diag1.write_species = 0
diag1.fields_to_plot = rho Te radiation_material_energy \
    radiation_diffusion_energy

warpx.reduced_diags_names = radiation_energy

radiation_energy.type = RadiationEnergy
radiation_energy.intervals = 1
radiation_energy.path = diags/
radiation_energy.precision = 17
