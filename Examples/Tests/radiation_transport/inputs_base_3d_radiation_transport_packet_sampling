# Seeded, multi-packet diffusion-to-streaming conversion in one 3-D cell.

max_step = 1
amr.n_cell = 2 2 2
amr.max_level = 0
amr.max_grid_size = 2
geometry.dims = 3
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 1.0 1.0

boundary.field_lo = periodic periodic periodic
boundary.field_hi = periodic periodic periodic
boundary.particle_lo = periodic periodic periodic
boundary.particle_hi = periodic periodic periodic

warpx.const_dt = 1.0e-16
warpx.verbose = 0
warpx.use_filter = 0
warpx.random_seed = 42

algo.maxwell_solver = yee
algo.particle_shape = 1
algo.current_deposition = direct

particles.species_names = photons
photons.species_type = photon
photons.injection_style = none
photons.do_not_deposit = 1
photons.do_not_gather = 1
photons.do_not_push = 1

radiation_transport.enabled = 1
radiation_transport.photon_species = photons
radiation_transport.absorption_coefficient = 0.0
radiation_transport.material_coupling = none
radiation_transport.enable_lte_exchange = 0
radiation_transport.enable_diffusion = 1
radiation_transport.rosseland_transport_coefficient = 0.5
radiation_transport.minimum_diffusion_optical_depth = 1.0
radiation_transport.diffusion_cfl = 0.5
radiation_transport.enable_particle_conversion = 1
radiation_transport.emission_photon_energy = 1.0e-15
radiation_transport.particle_conversion_packets_per_cell = 8
radiation_transport.initial_diffusion_energy_density(x,y,z) = \
    if(x < 0.5, if(y < 0.5, if(z < 0.5, 8.0e-13, 0.0), 0.0), 0.0)

diagnostics.diags_names = diag1
diag1.diag_type = Full
diag1.format = plotfile
diag1.intervals = 1
diag1.file_prefix = diags/diag1
diag1.write_species = 1
diag1.species = photons
diag1.fields_to_plot = radiation_diffusion_energy

warpx.reduced_diags_names = radiation_energy
radiation_energy.type = RadiationEnergy
radiation_energy.intervals = 1
radiation_energy.path = diags/
radiation_energy.precision = 17

amrex.abort_on_unused_inputs = 1
