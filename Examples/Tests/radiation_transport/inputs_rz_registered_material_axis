# Manufactured RZ fixed-charge material, NOT calibrated tungsten physics.
#
# The registry table handle (or the matching analytic opacity expressions) is
# supplied on the command line.  In particular, this deck intentionally defines
# no material-table or opacity coefficients.  With charge state +20 and
# n_i = 10/(183.84 amu), the native electron state has n_e = 20*n_i and
# n_e*(183.84 amu)/20 = 10 kg/m^3; no independent mass-density field is set.

my_constants.amu = 1.66053906892e-27
my_constants.n0 = 10.0/(183.84*amu)
my_constants.radiation_excitation = 1
my_constants.radial_origin = 0

max_step = 0
amrex.the_arena_init_size = 0

amr.n_cell = 16 16
amr.max_level = 0
amr.max_grid_size = 8 8

geometry.dims = RZ
geometry.prob_lo = 0.0 0.0
geometry.prob_hi = 0.5 1.0
warpx.n_rz_azimuthal_modes = 1

boundary.field_lo = none periodic
boundary.field_hi = pec periodic
boundary.particle_lo = none periodic
boundary.particle_hi = reflecting periodic

warpx.const_dt = 1.e-11
warpx.verbose = 0
warpx.random_seed = 42
warpx.grid_type = collocated
warpx.use_filter = 0

algo.maxwell_solver = hybrid
algo.particle_shape = 1
algo.current_deposition = direct

hybrid_pic_model.elec_temp = 10000*kb/q_e
hybrid_pic_model.initial_elec_temp(x,y,z) = \
    "10000*kb/q_e*(1+0.1*cos(2*pi*(x-radial_origin)/0.5)*cos(2*pi*z))"
hybrid_pic_model.n0_ref = 20*n0
hybrid_pic_model.n_floor = 1.e-6*20*n0
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.substeps = 2
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0
hybrid_pic_model.solve_electron_energy_equation = 1
hybrid_pic_model.include_joule_heating = 0
hybrid_pic_model.electron_thermodynamics = ideal_gas

particles.species_names = ions photons

ions.mass = 183.84*amu
ions.charge = 20*q_e
ions.injection_style = NUniformPerCell
ions.num_particles_per_cell_each_dim = 8 1 8
# Uniform radial locations with cylindrical particle weights resolve the axis.
# Equal-weight volume loading at this particle count leaves the axis unsampled.
ions.radial_numpercell_power = 0.0
ions.profile = constant
ions.density = n0
ions.momentum_distribution_type = at_rest
ions.do_not_push = 1
ions.do_not_gather = 1

photons.species_type = photon
photons.injection_style = none
photons.do_not_deposit = 1
photons.do_not_gather = 1
photons.do_not_push = 1

radiation_transport.enabled = 1
radiation_transport.photon_species = photons
radiation_transport.material_coupling = hybrid_electrons
radiation_transport.energy_group_boundaries = 2.e-19
radiation_transport.group_photon_energies = 1.e-19 4.e-19
radiation_transport.enable_lte_exchange = 1
radiation_transport.enable_diffusion = 1
radiation_transport.diffusion_solver = coupled_implicit
radiation_transport.diffusion_gradient = vector
radiation_transport.diffusion_implicit_tolerance = 1.e-11
radiation_transport.diffusion_linear_tolerance = 1.e-14
radiation_transport.lte_exchange_tolerance = 1.e-11
radiation_transport.lte_exchange_max_iterations = 100
radiation_transport.enable_particle_conversion = 0
radiation_transport.enable_momentum_coupling = 0
radiation_transport.initial_diffusion_energy_density_g0(x,y,z) = \
    "radiation_excitation*1.e7*(1+0.1*cos(2*pi*(x-radial_origin)/0.5)*cos(2*pi*z))"
radiation_transport.initial_diffusion_energy_density_g1(x,y,z) = \
    "radiation_excitation*2.e6*(1-0.1*cos(2*pi*(x-radial_origin)/0.5)*cos(2*pi*z))"

diagnostics.enable = 0
