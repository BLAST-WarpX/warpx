# Reuse the fixed-Z=2 native material fixture, with radiation-only evolution.
FILE = ../electron_thermodynamics/inputs_base_1d_hybrid_spiner_z2_pressure_work
max_step = 0
my_constants.rho0 = 1000
my_constants.density_amplitude = 0
my_constants.Te0_eV = 0.025851999786435
my_constants.domain_length = 1.e-3
my_constants.dt = 1.e-13
ions.do_not_push = 1
ions.do_not_gather = 1
particles.species_names = ions photons
photons.species_type = photon
photons.injection_style = none
photons.do_not_push = 1
photons.do_not_deposit = 1
photons.do_not_gather = 1
radiation_transport.enabled = 1
radiation_transport.photon_species = photons
radiation_transport.absorption_coefficient = 0
radiation_transport.material_coupling = hybrid_electrons
radiation_transport.minimum_electron_density = 0.1*ne0
radiation_transport.enable_lte_exchange = 1
radiation_transport.enable_diffusion = 1
radiation_transport.diffusion_solver = coupled_implicit
radiation_transport.initial_diffusion_energy_density(x,y,z) = "2.e9*(1+0.2*cos(2*pi*z/domain_length))"
radiation_transport.planck_absorption_coefficient = 1000
radiation_transport.rosseland_transport_coefficient(x,y,z,t,ne,Te) = "1.e5*(Te/300)^2"
radiation_transport.diffusion_implicit_tolerance = 1.e-12
radiation_transport.diffusion_linear_tolerance = 1.e-14
radiation_transport.lte_exchange_tolerance = 1.e-12
radiation_transport.lte_exchange_max_iterations = 100
radiation_transport.coupled_max_subdivisions = 4
