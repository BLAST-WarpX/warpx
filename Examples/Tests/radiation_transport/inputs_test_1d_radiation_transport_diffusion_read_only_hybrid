# FLD with LTE disabled and Hybrid-PIC used only as the Rosseland-opacity
# state provider. The opacity depends on nonzero ne and Te, so this catches an
# accidental replacement of the real read-only state with zero placeholders.

max_step = 1
amr.n_cell = 8
amr.max_level = 0
amr.max_grid_size = 8
geometry.dims = 1
geometry.prob_lo = 0.0
geometry.prob_hi = 1.0

boundary.field_lo = periodic
boundary.field_hi = periodic
boundary.particle_lo = periodic
boundary.particle_hi = periodic

warpx.const_dt = 1.0e-10
warpx.verbose = 0
warpx.grid_type = collocated
warpx.use_filter = 0
warpx.serialize_initial_conditions = 1

algo.maxwell_solver = hybrid
algo.particle_shape = 1
algo.current_deposition = direct

hybrid_pic_model.elec_temp = 10.0
hybrid_pic_model.n0_ref = 1.0e20
hybrid_pic_model.n_floor = 1.0e18
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.substeps = 2
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.solve_electron_energy_equation = 1
hybrid_pic_model.include_joule_heating = 0
hybrid_pic_model.electron_thermodynamics = ideal_gas

particles.species_names = ions photons

ions.species_type = proton
ions.injection_style = NUniformPerCell
ions.num_particles_per_cell_each_dim = 1
ions.profile = constant
ions.density = 1.0e20
ions.momentum_distribution_type = at_rest
ions.do_not_gather = 1
ions.do_not_push = 1

photons.species_type = photon
photons.injection_style = none
photons.do_not_deposit = 1
photons.do_not_gather = 1
photons.do_not_push = 1

radiation_transport.enabled = 1
radiation_transport.photon_species = photons
radiation_transport.absorption_coefficient = 0.0
radiation_transport.material_coupling = hybrid_electrons
radiation_transport.minimum_electron_density = 1.0e18
radiation_transport.group_photon_energies = 1.0e-15
radiation_transport.enable_lte_exchange = 0
radiation_transport.enable_diffusion = 1
radiation_transport.rosseland_transport_coefficient(x,y,z,t,photon_energy,ne,Te) = \
    20.0*(ne > 0.0)*(Te > 0.0)
radiation_transport.minimum_diffusion_optical_depth = 1.0
radiation_transport.diffusion_cfl = 0.5
radiation_transport.enable_particle_conversion = 0
radiation_transport.initial_diffusion_energy_density(x,y,z) = \
    if(z > 0.374, if(z < 0.501, 1.0, 0.0), 0.0)

diagnostics.diags_names = diag1
diag1.diag_type = Full
diag1.format = plotfile
diag1.intervals = 1
diag1.file_prefix = diags/diag1
diag1.write_species = 0
diag1.fields_to_plot = radiation_material_energy radiation_diffusion_energy

warpx.reduced_diags_names = radiation_energy
radiation_energy.type = RadiationEnergy
radiation_energy.intervals = 1
radiation_energy.path = diags/
radiation_energy.precision = 17

amrex.abort_on_unused_inputs = 1
