# Photons escape radial/axial faces; massive particles still reflect.
# A third photon crosses the coordinate axis and must remain in the domain.
max_step = 2
amr.n_cell = 8 8
amr.max_level = 0
amr.blocking_factor = 4 4
amr.max_grid_size = 8 8
geometry.dims = RZ
geometry.prob_lo = 0.0 -0.5
geometry.prob_hi = 1.0 0.5
boundary.field_lo = none pec
boundary.field_hi = pec pec
boundary.particle_lo = none reflecting
boundary.particle_hi = reflecting reflecting
warpx.n_rz_azimuthal_modes = 1
warpx.const_dt = 0.05/clight
warpx.verbose = 0
warpx.use_filter = 0
algo.maxwell_solver = yee
algo.particle_shape = 1
particles.species_names = tracer photons
tracer.mass = 1.0
tracer.charge = q_e
tracer.injection_style = SingleParticle
tracer.single_particle_pos = 0.995 0.0 0.0
tracer.single_particle_u = 0.2 0.0 0.0
tracer.single_particle_weight = 1.0
tracer.do_not_deposit = 1
tracer.do_not_gather = 1
photons.species_type = photon
photons.injection_style = MultipleParticles
photons.multiple_particles_pos_x = 0.98 0.5 0.02
photons.multiple_particles_pos_y = 0.0 0.0 0.0
photons.multiple_particles_pos_z = 0.0 0.48 0.0
photons.multiple_particles_ux = 1.0 0.0 -1.0
photons.multiple_particles_uy = 0.0 0.0 0.0
photons.multiple_particles_uz = 0.0 1.0 0.0
photons.multiple_particles_weight = 1.0e12 1.0e12 1.0e12
photons.do_not_deposit = 1
photons.do_not_gather = 1
photons.do_not_push = 1
radiation_transport.enabled = 1
radiation_transport.photon_species = photons
radiation_transport.photon_boundary = absorbing
radiation_transport.material_coupling = none
radiation_transport.absorption_coefficient = 0.0
diagnostics.diags_names = diag chk
diag.diag_type = Full
diag.format = plotfile
diag.file_prefix = diags/plt
diag.intervals = 1
diag.fields_to_plot = Er
diag.species = tracer photons
chk.diag_type = Full
chk.format = checkpoint
chk.file_prefix = diags/chk
chk.intervals = 1
warpx.reduced_diags_names = radiation_energy
radiation_energy.type = RadiationEnergy
radiation_energy.path = diags/
radiation_energy.intervals = 1
radiation_energy.precision = 17
amrex.abort_on_unused_inputs = 1
amrex.the_arena_init_size = 0
