if(WarpX_LIB AND WarpX_PRECISION STREQUAL "DOUBLE" AND
   WarpX_PARTICLE_PRECISION STREQUAL "DOUBLE")
    add_executable(test_leakage_axis_moments test_leakage_axis_moments.cpp)
    target_include_directories(test_leakage_axis_moments PRIVATE ${PROJECT_SOURCE_DIR}/Source)
    target_compile_features(test_leakage_axis_moments PRIVATE cxx_std_20)
    add_test(NAME test_leakage_axis_moments COMMAND test_leakage_axis_moments)
    foreach(dim IN ITEMS 1 2 3)
        if(NOT dim IN_LIST WarpX_DIMS)
            continue()
        endif()
        warpx_set_suffix_dims(suffix ${dim})
        set(target test_cartesian_leakage_faces_${suffix})
        add_executable(${target} test_cartesian_leakage_faces.cpp)
        target_link_libraries(${target} PRIVATE lib_${suffix})
        if(WarpX_COMPUTE STREQUAL "CUDA")
            setup_target_for_cuda_compilation(${target})
            target_compile_features(${target} PRIVATE cuda_std_20)
        else()
            target_compile_features(${target} PRIVATE cxx_std_20)
        endif()
        add_test(NAME ${target} COMMAND ${target})
        set_tests_properties(${target} PROPERTIES ENVIRONMENT "OMP_NUM_THREADS=1" TIMEOUT 30)
        if(WarpX_MPI)
            add_test(NAME ${target}_mpi3 COMMAND ${MPIEXEC_EXECUTABLE}
                ${MPIEXEC_NUMPROC_FLAG} 3 ${MPIEXEC_PREFLAGS} $<TARGET_FILE:${target}> ${MPIEXEC_POSTFLAGS})
            set_tests_properties(${target}_mpi3 PROPERTIES ENVIRONMENT "OMP_NUM_THREADS=1"
                PROCESSORS 3 TIMEOUT 30)
        endif()
    endforeach()
endif()
if(WarpX_LIB AND "RZ" IN_LIST WarpX_DIMS AND WarpX_PRECISION STREQUAL "DOUBLE"
   AND WarpX_PARTICLE_PRECISION STREQUAL "DOUBLE")
    foreach(fixture IN ITEMS photon_transaction leakage_faces)
        set(target test_rz_${fixture})
        add_executable(${target} test_rz_${fixture}.cpp)
        target_link_libraries(${target} PRIVATE lib_rz)
        if(WarpX_COMPUTE STREQUAL "CUDA")
            setup_target_for_cuda_compilation(${target})
            target_compile_features(${target} PRIVATE cuda_std_20)
        else()
            target_compile_features(${target} PRIVATE cxx_std_20)
        endif()
        foreach(case IN ITEMS axis annulus)
            set(args)
            if(case STREQUAL annulus)
                set(args "geometry.prob_lo=0.2 -0.5" "boundary.field_lo=pec periodic"
                    "boundary.particle_lo=reflecting periodic")
            endif()
            file(MAKE_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/${target}_${case})
            add_test(NAME ${target}_${case} COMMAND ${target}
                ${CMAKE_CURRENT_SOURCE_DIR}/inputs_rz_photon_transaction ${args})
            set_tests_properties(${target}_${case} PROPERTIES TIMEOUT 45
                ENVIRONMENT "OMP_NUM_THREADS=1"
                WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/${target}_${case})
        endforeach()
    endforeach()
endif()
