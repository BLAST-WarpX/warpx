# 1D mixed photon faces: absorbing lo, reflecting hi. Material remains reflecting.
max_step = 2
amr.n_cell = 16
amr.max_level = 0
amr.max_grid_size = 8
geometry.dims = 1
geometry.prob_lo = 0.0
geometry.prob_hi = 1.0
boundary.field_lo = pec
boundary.field_hi = pec
boundary.particle_lo = reflecting
boundary.particle_hi = reflecting
warpx.const_dt = 0.25/clight
warpx.verbose = 0
warpx.use_filter = 0
algo.maxwell_solver = yee
algo.particle_shape = 1
particles.species_names = photons
photons.species_type = photon
photons.injection_style = MultipleParticles
photons.multiple_particles_pos_x = 0.0 0.0
photons.multiple_particles_pos_y = 0.0 0.0
photons.multiple_particles_pos_z = 0.30 0.70
photons.multiple_particles_ux    = 0.0 0.0
photons.multiple_particles_uy    = 0.0 0.0
photons.multiple_particles_uz    = -1.0 1.0
photons.multiple_particles_weight = 1.0e12 1.0e12
photons.do_not_deposit = 1
photons.do_not_gather = 1
photons.do_not_push = 1
radiation_transport.enabled = 1
radiation_transport.photon_species = photons
radiation_transport.photon_boundary = inherit
radiation_transport.photon_boundary_lo = absorbing
radiation_transport.photon_boundary_hi = reflecting
radiation_transport.material_coupling = none
radiation_transport.absorption_coefficient = 0.0
radiation_transport.enable_momentum_coupling = 0
diagnostics.diags_names = diag chk
diag.diag_type = Full
diag.format = plotfile
diag.file_prefix = diags/plt
diag.intervals = 1
diag.fields_to_plot = Ex
diag.species = photons
chk.diag_type = Full
chk.format = checkpoint
chk.file_prefix = diags/chk
chk.intervals = 1
warpx.reduced_diags_names = radiation_energy
radiation_energy.type = RadiationEnergy
radiation_energy.path = diags/
radiation_energy.intervals = 1
radiation_energy.precision = 17
amrex.abort_on_unused_inputs = 1
amrex.the_arena_init_size = 0
