# A photon on z=.5 leaves the thick cell immediately; it must stay streaming.
max_step = 1
amr.n_cell = 4
amr.max_level = 0
amr.blocking_factor = 2
amr.max_grid_size = 2
geometry.dims = 1
geometry.prob_lo = 0
geometry.prob_hi = 1
boundary.field_lo = periodic
boundary.field_hi = periodic
boundary.particle_lo = periodic
boundary.particle_hi = periodic
warpx.const_dt = 0.1/clight
warpx.verbose = 0
warpx.use_filter = 0
algo.maxwell_solver = yee
algo.particle_shape = 1
algo.current_deposition = direct
particles.species_names = photons
photons.species_type = photon
photons.injection_style = SingleParticle
photons.single_particle_pos = 0 0 0.5
photons.single_particle_u = 0 0 -1
photons.single_particle_weight = 1.e16
photons.do_not_deposit = 1
photons.do_not_gather = 1
photons.do_not_push = 1
radiation_transport.enabled = 1
radiation_transport.photon_species = photons
radiation_transport.absorption_coefficient = 2
radiation_transport.material_coupling = none
radiation_transport.enable_lte_exchange = 0
radiation_transport.enable_diffusion = 1
radiation_transport.rosseland_transport_coefficient(x,y,z,t,ne,Te) = if(z<0.5,0,1.e24)
radiation_transport.enable_particle_conversion = 1
radiation_transport.emission_photon_energy = 1.e-13
diagnostics.diags_names = diag
diag.diag_type = Full
diag.format = plotfile
diag.intervals = 1
diag.file_prefix = diags/diag
diag.write_species = 0
diag.fields_to_plot = radiation_material_energy radiation_diffusion_energy
warpx.reduced_diags_names = particle_energy
particle_energy.type = ParticleEnergy
particle_energy.intervals = 1
particle_energy.path = diags/
particle_energy.precision = 17
amrex.abort_on_unused_inputs = 1
