# base input parameters
FILE = inputs_base_2d

# test input parameters
algo.maxwell_solver = ckc
amr.max_level = 1
amr.ref_ratio = 4
diag1.electrons.variables = x z w ux uy uz
diag1.positrons.variables = x z w ux uy uz
warpx.fine_tag_hi =  10.e-6  10.e-6
warpx.fine_tag_lo = -10.e-6 -10.e-6
warpx.use_filter = 1

# Direct current deposition, which also supports the shared-memory deposition
algo.current_deposition = direct

# Same as test_2d_langmuir_multi_mr_direct, with the shared-memory current deposition (GPU only).
# The particles in the mesh-refinement buffers are separated from the others in each tile:
# only the latter (i.e. a subset of the particles of the tile) use the shared-memory kernel.
warpx.do_shared_mem_current_deposition = 1
