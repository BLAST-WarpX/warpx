max_step = 5

############################################
# Geometry
############################################
geometry.dims = 2

geometry.prob_lo = -20.e-6  -20.e-6
geometry.prob_hi =  20.e-6   20.e-6

amr.n_cell = 8 8
amr.max_grid_size = 16
amr.max_level = 0

boundary.field_lo = periodic periodic
boundary.field_hi = periodic periodic

boundary.particle_lo = periodic periodic
boundary.particle_hi = periodic periodic

############################################
# Algorithms
############################################
algo.particle_shape = 1
algo.field_gathering = energy-conserving
warpx.use_filter = 0
warpx.do_dive_cleaning = 1
warpx.serialize_initial_conditions = 1

############################################
# Time step
############################################
warpx.const_dt = 1.e-14

############################################
# Particle species
############################################

particles.species_names = electrons positrons

electrons.charge = -q_e
electrons.mass = m_e

positrons.charge = q_e
positrons.mass = m_e

electrons.injection_style = SingleParticle
electrons.single_particle_pos = -1.8e-6  0.0  0.5e-6
electrons.single_particle_u = 0.0 0.0 1.5
electrons.single_particle_weight = 1.0

positrons.injection_style = SingleParticle
positrons.single_particle_pos = -1.8e-6  0.0  0.5e-6
positrons.single_particle_u = 0.0 0.0 -1.5
positrons.single_particle_weight = 1.0

warpx.synchronize_velocity_for_diagnostics = 1

diagnostics.diags_names = diag1

############################################
# Particle splitting
############################################

electrons.do_resampling = 1
electrons.resampling_algorithm = particle_splitting
electrons.resampling_trigger_intervals = 1
electrons.resampling_min_ppc = 1
electrons.resampling_split_weight_koef = 0.5
electrons.resampling_splitting_type = axis_aligned
electrons.splitting_max_ppc = 10000
electrons.do_remapping_current = 1

diag1.intervals = 1
diag1.format = openpmd
diag1.diag_type = Full
diag1.fields_to_plot = Ex Ey Ez rho_electrons divE rho
diag1.electrons.variables = x z w ux uy uz
