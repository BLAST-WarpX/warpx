# Compact quantitative regression for overlapping prescribed-current drives.

max_step = 2
amr.n_cell = 8 8 8
amr.max_grid_size = 8
amr.blocking_factor = 8
amr.max_level = 0

geometry.dims = 3
geometry.prob_lo = -0.5 -0.5 -0.5
geometry.prob_hi =  0.5  0.5  0.5
boundary.field_lo = periodic periodic periodic
boundary.field_hi = periodic periodic periodic

warpx.const_dt = 1.0e-12
warpx.verbose = 1
algo.maxwell_solver = yee
algo.particle_shape = 1
algo.current_deposition = direct

warpx.current_injection = 1
warpx.current_injection.file = current_profile.txt
warpx.current_injection.n_pairs = 2

# I(1 ps) = 2000 A and A = 0.25 m^2 -> Jx = 8000 A/m^2.
warpx.current_injection.pair_0.drive.xlo = -0.25
warpx.current_injection.pair_0.drive.xhi =  0.25
warpx.current_injection.pair_0.drive.ylo = -0.25
warpx.current_injection.pair_0.drive.yhi =  0.25
warpx.current_injection.pair_0.drive.zlo = -0.25
warpx.current_injection.pair_0.drive.zhi =  0.25
warpx.current_injection.pair_0.drive.A = 0.25
warpx.current_injection.pair_0.drive.dir = 0
warpx.current_injection.pair_0.drive.sign = 1

# Same box, distinct waveform/direction/sign. I(1 ps) = 1000 A -> Jy = -4000 A/m^2.
warpx.current_injection.pair_1.file = current_profile_override.txt
warpx.current_injection.pair_1.drive.xlo = -0.25
warpx.current_injection.pair_1.drive.xhi =  0.25
warpx.current_injection.pair_1.drive.ylo = -0.25
warpx.current_injection.pair_1.drive.yhi =  0.25
warpx.current_injection.pair_1.drive.zlo = -0.25
warpx.current_injection.pair_1.drive.zhi =  0.25
warpx.current_injection.pair_1.drive.A = 0.25
warpx.current_injection.pair_1.drive.dir = 1
warpx.current_injection.pair_1.drive.sign = -1

diagnostics.diags_names = diag1 chk
diag1.diag_type = Full
diag1.intervals = -1
diag1.fields_to_plot = jx jy jz rho
diag1.format = plotfile
diag1.file_prefix = diags/diag1

chk.diag_type = Full
chk.intervals = 1
chk.format = checkpoint
chk.file_prefix = diags/chk
