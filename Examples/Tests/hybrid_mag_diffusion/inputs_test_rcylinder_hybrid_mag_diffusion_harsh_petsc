# RCYLINDER hybrid implicit magnetic-diffusion HARSH-vacuum PETSc test (T2).
# IDENTICAL physics to inputs_test_rcylinder_hybrid_mag_diffusion_harsh (same eta=129,
# dt, grid, PEC r_hi, theta=1, rtol=1e-8, atol=0), differing ONLY in the linear
# solver: PETSc KSP (MATSHELL matvec = the same matrix-free cylindrical operator)
# with the assembled frozen-η curl-curl Pmat. The Pmat
# now carries the cylindrical 1/r metric in the radial stencil and the Bt -1/r^2
# diagonal term (off-axis), so it is a usable proxy at stiff eta=129 -- the case
# the old Cartesian Pmat was never exercised on.
#
# r_hi = PEC (Neumann dBt/dr = 0) is REQUIRED for a well-posed Bt solve: with
# "none" at r_hi the cylindrical operator has a Bt proportional-to-r steady-
# state NULL MODE (K(Bt=r) = 0), leaving the system singular. PEC excludes
# Bt=r (dBt/dr=k!=0) -> unique, well-posed solution. See the harsh test header
# and notes/2026-07-19_rcyl_mag_diff_port.md.
#
# Oracle (analysis_rcyl.py, reused): finite Bt; final Bt amplitude < 1e-3 *
# initial (>99.9% damped in 5 steps at eta=129, dt=1ns -- the slowest Bessel
# mode annihilated); AND the analytic explicit-resistive CFL violation ratio
# (const_dt / dt_resistive_explicit > 1e3). "Completes + finite + strongly
# damped", matching the harsh AMReX GMRES test (a parity L2 of the annihilated
# ~1e-7 fields would be too noisy to be meaningful, so the absolute damping
# oracle is the strong check). theta=1 only.

max_step = 5
amr.n_cell = 64
amr.max_level = 0
amr.blocking_factor = 8
amr.max_grid_size = 64

geometry.dims = RCYLINDER
geometry.prob_lo = 0.0
geometry.prob_hi = 2.0e-2

# r=0 axis (none). r_hi = PEC (Neumann for Bt; excludes the Bt~r null mode).
# No pec_insulator: the Rcyl affine-feed split is a documented follow-up.
boundary.field_lo = none
boundary.field_hi = pec
boundary.particle_lo = none
boundary.particle_hi = absorbing

warpx.const_dt = 1.0e-9
warpx.cfl = -1.
warpx.do_initial_div_cleaning = false

algo.maxwell_solver = hybridPIC
algo.particle_shape = 1
algo.current_deposition = direct

particles.species_names = protons
particles.do_tiling = true

protons.species_type = hydrogen
protons.injection_style = NUniformPerCell
protons.num_particles_per_cell_each_dim = 2 1
protons.profile = constant
protons.density = 1.0e26
protons.momentum_distribution_type = constant
protons.ux = 0.0
protons.uy = 0.0
protons.uz = 0.0

# RCYLINDER component order is Br, Bt, Bz (same as RZ). Uniform Bt init.
warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0.0 1.0e-4 0.0

hybrid_pic_model.elec_temp = 0.1
hybrid_pic_model.gamma = 1.0
hybrid_pic_model.n0_ref = 1.0e26
hybrid_pic_model.n_floor = 1.0e20
hybrid_pic_model.substeps = 4
hybrid_pic_model.plasma_resistivity(rho,J,t) = "129.0"
hybrid_pic_model.plasma_hyper_resistivity(rho,B) = "0.0"

hybrid_pic_model.implicit_mag_diffusion = 1
hybrid_pic_model.mag_diff_theta = 1.0
hybrid_pic_model.mag_diff_use_variable_eta = 1
hybrid_pic_model.mag_diff_eta_explicit_max = 0.0
# PETSc KSP + cylindrical frozen-η curl-curl Pmat (assembled PC proxy; the
# matvec is the true cylindrical operator). rtol=1e-8, atol=0 (CI linear tols).
hybrid_pic_model.mag_diff_linear_solver = petsc
hybrid_pic_model.mag_diff_rtol = 1.0e-8
hybrid_pic_model.mag_diff_atol = 0.0
hybrid_pic_model.mag_diff_max_iter = 500
hybrid_pic_model.mag_diff_verbose = 0

diagnostics.diags_names = diag1
diag1.intervals = 5
diag1.diag_type = Full
diag1.fields_to_plot = Br Bt Bz
diag1.format = plotfile
