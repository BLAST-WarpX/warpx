# 2D XZ hybrid magnetic-diffusion Crank-Nicolson smoke with a spatially varying
# (J-dependent) parser-frozen eta. plasma_resistivity = 1e-1 + 1e-4*J makes the
# frozen eta MultiFab genuinely non-uniform (eta varies by ~50% across the By
# mode), exercising the (1-theta) explicit curl RHS term on the matrix-free path
# with an arbitrary eta pattern -- not just a uniform parser eta. Periodic, so no
# feed; the Cartesian (non-RZ) branch of computeAFull is used. analysis_2d_smoke
# checks finite, damped By (no Fourier oracle: a J-dependent eta has no single
# exponential mode).

max_step = 20
amr.n_cell = 64 64
amr.max_level = 0
amr.blocking_factor = 8
amr.max_grid_size = 64

geometry.dims = 2
geometry.prob_lo = 0.0  0.0
geometry.prob_hi = 1.0  1.0

boundary.field_lo = periodic periodic
boundary.field_hi = periodic periodic
boundary.particle_lo = periodic periodic
boundary.particle_hi = periodic periodic

warpx.const_dt = 1.0e-9
warpx.cfl = -1.

algo.maxwell_solver = hybridPIC
algo.particle_shape = 1
algo.current_deposition = direct

particles.species_names = protons
particles.do_tiling = true

protons.species_type = hydrogen
protons.injection_style = NUniformPerCell
protons.num_particles_per_cell_each_dim = 2 2
protons.profile = constant
protons.density = 1.0e26
protons.momentum_distribution_type = constant
protons.ux = 0.0
protons.uy = 0.0
protons.uz = 0.0

warpx.B_ext_grid_init_style = parse_B_ext_grid_function
warpx.Bx_external_grid_function(x,y,z) = "0.0"
warpx.By_external_grid_function(x,y,z) = "1.0e-4 * cos(2.*pi*x/1.0)"
warpx.Bz_external_grid_function(x,y,z) = "0.0"

hybrid_pic_model.elec_temp = 0.1
hybrid_pic_model.gamma = 1.0
hybrid_pic_model.n0_ref = 1.0e26
hybrid_pic_model.n_floor = 1.0e20
hybrid_pic_model.substeps = 4
# J-dependent parser eta: frozen each half-step from J = curl(B)/mu0, so the eta
# MultiFab is spatially varying (~0.10 to ~0.15 Ohm m across the By mode).
hybrid_pic_model.plasma_resistivity(rho,J,t) = "1.0e-1 + 1.0e-4*J"
hybrid_pic_model.plasma_hyper_resistivity(rho,B) = "0.0"

hybrid_pic_model.implicit_mag_diffusion = 1
hybrid_pic_model.mag_diff_theta = 0.5
hybrid_pic_model.mag_diff_use_variable_eta = 1
hybrid_pic_model.mag_diff_constant_eta = 1.0e-1
hybrid_pic_model.mag_diff_eta_explicit_max = 0.0
hybrid_pic_model.mag_diff_rtol = 1.0e-8
hybrid_pic_model.mag_diff_atol = 0.0
hybrid_pic_model.mag_diff_max_iter = 300
hybrid_pic_model.mag_diff_verbose = 0

diagnostics.diags_names = diag1
diag1.intervals = 20
diag1.diag_type = Full
diag1.fields_to_plot = By Bx Bz
diag1.format = plotfile
