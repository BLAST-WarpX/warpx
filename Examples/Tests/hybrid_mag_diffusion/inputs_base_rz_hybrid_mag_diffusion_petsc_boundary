# The default PEC_Insulator area is PEC. Normal B DOFs are clamped on
# r_hi and both z endwalls. The independent random-vector operator audit
# exercises Br/Bz couplings even though the physical seed is toroidal.
max_step = 2
amr.n_cell = 32 64
amr.max_level = 0
amr.blocking_factor = 8
amr.max_grid_size = 32
geometry.dims = RZ
geometry.prob_lo = 0.0 0.0
geometry.prob_hi = 0.0656 0.128
boundary.field_lo = none pec_insulator
boundary.field_hi = pec_insulator pec_insulator
boundary.particle_lo = none absorbing
boundary.particle_hi = absorbing absorbing
warpx.const_dt = 1.e-9
warpx.cfl = -1.
warpx.do_initial_div_cleaning = false
algo.maxwell_solver = hybridPIC
algo.particle_shape = 1
algo.current_deposition = direct
particles.species_names = protons
particles.do_tiling = true
protons.species_type = hydrogen
protons.injection_style = NUniformPerCell
protons.num_particles_per_cell_each_dim = 2 1 2
protons.profile = constant
protons.density = 1.e26
protons.momentum_distribution_type = constant
protons.ux = 0.0
protons.uy = 0.0
protons.uz = 0.0
warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0.0 1.e-4 0.0
hybrid_pic_model.elec_temp = 0.1
hybrid_pic_model.gamma = 1.0
hybrid_pic_model.n0_ref = 1.e26
hybrid_pic_model.n_floor = 1.e20
hybrid_pic_model.substeps = 4
hybrid_pic_model.plasma_resistivity(rho,J,t) = "5.0"
hybrid_pic_model.plasma_hyper_resistivity(rho,B) = "0.0"
hybrid_pic_model.implicit_mag_diffusion = 1
hybrid_pic_model.mag_diff_theta = 1.0
hybrid_pic_model.mag_diff_use_variable_eta = 1
hybrid_pic_model.mag_diff_eta_explicit_max = 0.0
hybrid_pic_model.mag_diff_linear_solver = petsc
hybrid_pic_model.mag_diff_rtol = 1.e-8
hybrid_pic_model.mag_diff_atol = 0.0
hybrid_pic_model.mag_diff_max_iter = 500
hybrid_pic_model.mag_diff_petsc_pc_type = asm
hybrid_pic_model.mag_diff_petsc_asm_overlap = 0
hybrid_pic_model.mag_diff_petsc_sub_pc_type = ilu
hybrid_pic_model.mag_diff_petsc_ilu_factor_levels = 1
diagnostics.diags_names = diag1
diag1.intervals = 2
diag1.diag_type = Full
diag1.fields_to_plot = Br Bt Bz
diag1.format = plotfile
