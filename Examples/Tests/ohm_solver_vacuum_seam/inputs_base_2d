# Vacuum-seam switch-mode test bed: a magnetized plasma disk drifts across
# a periodic 2D (XZ) box, so its circular plasma/vacuum seam samples every
# angle and cell phase.
# With the legacy per-edge switch decision the three E components take
# inconsistent vacuum/plasma decisions at the seam (a grid-patterned
# spurious-E source); the node/cell decision modes remove it. The seam
# decision drives the holmstrom vacuum branch here (the guarded_* tests
# override holmstrom_vacuum_region back off to exercise the guarded Hall
# density-floor selection instead).
max_step = 10
warpx.const_dt = 1.5e-9

amr.n_cell = 128 128
amr.max_grid_size = 128
amr.blocking_factor = 8
amr.max_level = 0

geometry.dims = 2
geometry.prob_lo = -0.8 -0.8
geometry.prob_hi =  0.8  0.8

boundary.field_lo = periodic periodic
boundary.field_hi = periodic periodic
boundary.particle_lo = periodic periodic
boundary.particle_hi = periodic periodic

algo.maxwell_solver = hybrid
algo.particle_shape = 2
algo.current_deposition = direct

hybrid_pic_model.elec_temp = 1.0
hybrid_pic_model.n0_ref = 1e18
hybrid_pic_model.gamma = 1.0
hybrid_pic_model.n_floor = 5e16
hybrid_pic_model.substeps = 10
hybrid_pic_model.holmstrom_vacuum_region = 1

warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0.02 0. 0.

particles.species_names = ions
ions.charge = q_e
ions.mass = m_p
ions.injection_style = NUniformPerCell
ions.num_particles_per_cell_each_dim = 2 2
ions.profile = parse_density_function
ions.density_function(x,y,z) = "1e18*((x*x+z*z)<(0.35*0.35))"
ions.momentum_distribution_type = constant
ions.ux = -5.7e-5
ions.uy = 0.
ions.uz = 1.4e-4

diagnostics.diags_names = diag1
diag1.intervals = 10
diag1.diag_type = Full
diag1.fields_to_plot = Ex Ey Ez Bx By Bz rho
diag1.format = plotfile
diag1.plot_raw_fields = 1
