# Shared loading regression: a physical spherical layer in an RZ mesh.
# The density mask must be evaluated at mapped physical, not logical radii.
my_constants.power = 1
max_step = 0
amr.n_cell = 32 64
amr.max_level = 0
amr.blocking_factor = 8 8
amr.max_grid_size = 16 32
geometry.dims = RZ
geometry.prob_lo = 0.0 -1.0
geometry.prob_hi = 1.0 1.0
boundary.field_lo = none periodic
boundary.field_hi = pec periodic
boundary.particle_lo = none periodic
boundary.particle_hi = reflecting periodic
warpx.n_rz_azimuthal_modes = 1
warpx.const_dt = 1.0e-12
warpx.verbose = 0
warpx.use_filter = 0
warpx.serialize_initial_conditions = 1
algo.maxwell_solver = yee
algo.particle_shape = 1
particles.species_names = electrons
electrons.species_type = electron
electrons.injection_style = NUniformPerCell
electrons.num_particles_per_cell_each_dim = 4 1 4
electrons.radial_numpercell_power = power
electrons.random_theta = 0
electrons.xmin = 0.0
electrons.xmax = 1.0
electrons.zmin = -1.0
electrons.zmax = 1.0
electrons.profile = parse_density_function
electrons.density_function(x,y,z) = if(x*x+y*y+z*z>0.25^2,if(x*x+y*y+z*z<0.65^2,1.0e20,0.0),0.0)
electrons.momentum_distribution_type = at_rest
electrons.do_not_deposit = 1
electrons.do_not_gather = 1
electrons.do_not_push = 1
diagnostics.diags_names = diag
diag.diag_type = Full
diag.format = plotfile
diag.file_prefix = diags/plt
diag.intervals = 1
diag.fields_to_plot = Er
diag.species = electrons
amrex.abort_on_unused_inputs = 1
