# A seeded vacuum wave on three face-connected refinement boxes.
# Disabling both regular and PML magnetic cleaning produces rapid field growth.
max_step = 250
geometry.dims = 3
geometry.prob_lo = -0.025 -0.025 -0.004166666666666667
geometry.prob_hi = 0.025 0.025 0.004166666666666667
amr.n_cell = 48 48 8
amr.max_level = 1
amr.ref_ratio = 2
amr.blocking_factor = 2
amr.max_grid_size = 64
amr.grid_eff = 1
amr.n_error_buf = 0
warpx.ref_patch_function(x,y,z) = "if((abs(x)<0.015625)*(abs(y)<0.008333333333333333)+(abs(x)<0.008333333333333333)*(abs(y)<0.015625)>0,1,0)"
boundary.field_lo = pml pml periodic
boundary.field_hi = pml pml periodic
boundary.particle_lo = absorbing absorbing periodic
boundary.particle_hi = absorbing absorbing periodic
warpx.cfl = 0.9
warpx.pml_ncell = 4
warpx.pml_delta = 4
warpx.do_initial_div_cleaning = 0
warpx.do_dive_cleaning = 0
warpx.do_pml_dive_cleaning = 0
warpx.do_divb_cleaning = 1
warpx.do_pml_divb_cleaning = 1
warpx.n_current_deposition_buffer = 0
warpx.n_field_gather_buffer = 0
warpx.use_filter = 1
algo.maxwell_solver = yee
algo.field_gathering = energy-conserving
algo.current_deposition = villasenor
algo.particle_shape = 3
particles.species_names = guard_probe
guard_probe.species_type = electron
guard_probe.injection_style = none
my_constants.radius = 0.00625
my_constants.length_z = 0.008333333333333333
warpx.E_ext_grid_init_style = parse_E_ext_grid_function
warpx.Ex_external_grid_function(x,y,z) = "-y/radius*exp(-(x*x+y*y)/(radius*radius))*cos(4*pi*z/length_z)"
warpx.Ey_external_grid_function(x,y,z) = "x/radius*exp(-(x*x+y*y)/(radius*radius))*cos(4*pi*z/length_z)"
warpx.Ez_external_grid_function(x,y,z) = 0
warpx.reduced_diags_names = field_energy particle_number
field_energy.type = FieldEnergy
field_energy.intervals = 10
particle_number.type = ParticleNumber
particle_number.intervals = 10
diagnostics.enable = 0
