#################################
####### GENERAL PARAMETERS ######
#################################
max_step = 10
amr.n_cell = 8 8 64
amr.max_grid_size = 32
amr.blocking_factor = 8
amr.max_level = 0
geometry.dims = 3
geometry.prob_lo     = -8.e-6 -8.e-6 -10.e-6
geometry.prob_hi     =  8.e-6  8.e-6  10.e-6

#################################
####### Boundary condition ######
#################################
boundary.field_lo = periodic periodic pml
boundary.field_hi = periodic periodic pml

#################################
############ NUMERICS ###########
#################################
algo.maxwell_solver = ckc
algo.particle_shape = 1
warpx.cfl = .99

#################################
######### MOVING WINDOW #########
#################################
# start_moving_window_step is left at its default (0), and only
# end_moving_window_step is set, i.e. the window is active from the very
# first step and stops at step 4 (exclusive), well before the checkpoint
# at step 5. This is the most common real-world way to use
# end_moving_window_step (leaving start untouched) and specifically
# exercises the restart-time active-step count when start_moving_window_step
# is 0: a formula that fails to treat step indices as starting at 1 (as
# WarpX::moving_window_active() does) overcounts active steps by 2 here,
# not just 1, since both the "off-by-one" and the "step 0 does not exist"
# errors compound.
warpx.do_moving_window = 1
warpx.moving_window_dir = z
warpx.moving_window_v = 1. # in units of the speed of light
warpx.end_moving_window_step = 4

#################################
############ PLASMA #############
#################################
particles.species_names = beam

beam.charge = -q_e
beam.mass = m_e
beam.injection_style = "gaussian_beam"
beam.x_rms = .5e-6
beam.y_rms = .5e-6
beam.z_rms = 1.e-6
beam.x_m = 0.
beam.y_m = 0.
beam.z_m = -5.e-6
beam.npart = 1000
beam.q_tot = -5.e-14
beam.momentum_distribution_type = "gaussian"
beam.ux_m = 0.0
beam.uy_m = 0.0
beam.uz_m = 200.
beam.ux_th = 2.
beam.uy_th = 2.
beam.uz_th = 20.

# Diagnostics
diagnostics.diags_names = diag1 chk
diag1.intervals = 5
diag1.diag_type = Full
diag1.fields_to_plot = Ex Ey Ez jx jy jz rho
chk.intervals = 5
chk.diag_type = Full
chk.format = checkpoint
